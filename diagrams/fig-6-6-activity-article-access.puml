@startuml
' Figure 6.6 – Activity diagram: the article access decision
' Applies the access matrix server-side. The client is told the verdict and
' never computes it; locked content leaves the server as null.
!include _style.puml

start
:Receive a request for an article by slug;
if (the article exists and is not soft-deleted?) then (no)
  :Return 404;
  stop
else (yes)
endif

if (status = published?) then (no)
  if (the requester is the author?) then (yes)
    :Return the draft in full;
    stop
  else (no)
    :Return 404;
    note right
      A draft answers 404 rather than 403: acknowledging
      it would leak that the slug exists.
    end note
    stop
  endif
else (yes)
endif

if (placement?) then (marketplace)
  if (the requester is a magazine with an active subscription?) then (no)
    :Return the article as not visible;
    stop
  else (yes)
  endif
  if (previewed or purchased by this magazine?) then (yes)
    :Return the full content;
    stop
  else (no)
    :Return the title, excerpt and price\nwith content = null;
    stop
  endif
else (public)
  if (visibility?) then (free)
    :Return the full content, to guests included;
    note right
      A deliberate departure from the matrix, which
      reads as requiring an account. Gating free public
      articles would contradict the public feed and the
      SEO work, and would change the product.
    end note
    stop
  else (premium)
    if (the requester is the author, an administrator,\na premium reader, or a magazine that purchased it?) then (yes)
      :Return the full content;
      stop
    else (no)
      :Return the metadata with content = null\nand the upgrade prompt;
      stop
    endif
  endif
endif
@enduml
