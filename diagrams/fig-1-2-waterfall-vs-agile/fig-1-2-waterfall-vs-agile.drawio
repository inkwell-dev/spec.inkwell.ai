<mxfile host="Electron" type="device">
  <diagram id="fig-1-2-waterfall-vs-agile" name="Figure 1.2 - Classic and agile compared">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="730" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="wf" value="Classic — sequential phases" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="470" height="430" as="geometry"/></mxCell>
        <mxCell id="w1" value="Requirements" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="110" y="120" width="370" height="50" as="geometry"/></mxCell>
        <mxCell id="w2" value="Design" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="110" y="190" width="370" height="50" as="geometry"/></mxCell>
        <mxCell id="w3" value="Implementation" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="110" y="260" width="370" height="50" as="geometry"/></mxCell>
        <mxCell id="w4" value="Testing" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="110" y="330" width="370" height="50" as="geometry"/></mxCell>
        <mxCell id="w5" value="Delivery — once, at the end" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="110" y="400" width="370" height="50" as="geometry"/></mxCell>
        <mxCell id="ag" value="Agile — Scrum, iterative" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="610" y="70" width="530" height="430" as="geometry"/></mxCell>
        <mxCell id="s1" value="Sprint 1 — plan · build · verify → increment" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="650" y="120" width="450" height="50" as="geometry"/></mxCell>
        <mxCell id="s2" value="Sprint 2 — plan · build · verify → increment" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="450" height="50" as="geometry"/></mxCell>
        <mxCell id="s3" value="Sprint n — plan · build · verify → increment" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="650" y="260" width="450" height="50" as="geometry"/></mxCell>
        <mxCell id="s4" value="Working software every two weeks" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="650" y="330" width="450" height="50" as="geometry"/></mxCell>
        <mxCell id="s5" value="Scope absorbed between sprints, not frozen" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="650" y="400" width="450" height="50" as="geometry"/></mxCell>
        <mxCell id="why" value="Why Scrum was chosen for this project&lt;br&gt;&lt;br&gt;The scope moved twice and neither change restarted the work: voice input and three other features were descoped on 2026-07-26, and deployment was resequenced on 2026-08-10. A sequential plan would have had to re-open its requirements phase for both. Each phase also carries written exit criteria, which is what lets every release chapter show evidence rather than assert completion." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="1080" height="130" as="geometry"/></mxCell>
        <mxCell id="b1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="w1" target="w2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="w2" target="w3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="w3" target="w4"><mxGeometry relative="1" as="geometry"/></mxCell>
