@startuml
' Figure 2.3 – Class diagram: AI, marketplace and analytics
' The remaining 16 persisted classes and the enumerations they reference.
' User and Article appear as references only; they are defined in figure 2.2.
' Operations name the service methods that implement them. The article–document
' attachment holds only the pair and a date, so it is a many-to-many association.
!include ../_style.puml
skinparam nodesep 20
skinparam ranksep 45
hide circle
hide empty methods

class User {
  + countProgress() : Progress
}
class Article {
  + publish()
}

class ArticleChunk {
  - chunkIndex : Integer
  - content : Text
  - embedding : Vector
  + embedArticle(article : Article)
  + findSimilarChunks(query : String) : ArticleChunk[]
}
class WriterMemory {
  - tonePreferences : Json
  - styleExamples : Json
  - vocabularyPatterns : Json
  - topics : Json
  + extract()
}
class PortfolioInsight {
  - voiceSummary : Text
  - topicExpertise : Json
  - consistencyScore : Integer
  - expiresAt : Timestamp
  + generate()
  + getCached()
}
class Document {
  - title : String
  - filename : String
  - sizeBytes : Integer
  - storageKey : String
  - status : DocumentStatus
  - pageCount : Integer
  - error : Text
  - deletedAt : Timestamp
  + register()
  + retry()
  + remove()
}
class DocumentChunk {
  - chunkIndex : Integer
  - page : Integer
  - content : Text
  - embedding : Vector
  + ingest(document : Document)
  + findSimilarDocumentChunks(query : String) : DocumentChunk[]
}
class AiInteraction {
  - actionType : AiActionType
  - tokensUsed : Integer
  - model : String
  + billAction(tokens : Integer)
}
class Purchase {
  - stage : PurchaseStage
  - creditsPaid : Integer
  - platformFee : Integer
  - writerPayout : Integer
  + previewUnlock()
  + buy()
  + publish()
}
class Transaction {
  - type : TransactionType
  - amount : Integer
  - idempotencyKey : String
  - status : TransactionStatus
  + checkLedgerInvariants() : Violation[]
}
class MagazineSubscription {
  - status : SubscriptionStatus
  - creditsGranted : Integer
  - expiresAt : Timestamp
  + renew()
}
class EligibilityAuditLog {
  - source : EligibilitySource
  - readersAt : Integer
  - reactionsAt : Integer
  + record(source : EligibilitySource)
}
class AnalyticsEvent {
  - eventType : AnalyticsEventType
  - metadata : Json
  + createEvents(batch : AnalyticsEvent[])
}
class ArticleMetrics {
  - totalViews : Integer
  - totalUniqueViews : Integer
  - completionRate : Float
  - engagementRate : Float
  - paragraphDropoff : Json
  + aggregate()
}
class WriterAudienceMetrics {
  - totalUniqueReaders : Integer
  - returningReaderRate : Float
  - topCountries : Json
  - deviceSplit : Json
  + aggregate()
}
class WriterContentMetrics {
  - totalPublished : Integer
  - postingFrequency : Float
  - postingConsistency : Float
  - topTags : Json
  + aggregate()
}
class WriterQualityMetrics {
  - engagementRate : Float
  - repostRate : Float
  - commentDepth : Float
  - retentionCurve : Json
  + aggregate()
}

class PurchaseStage <<Enumeration>> {
  preview_unlock
  full_purchase
}
class TransactionType <<Enumeration>> {
  subscription_charge
  monthly_credit_grant
  credit_topup
  preview_unlock
  article_full_purchase
  writer_payout
  platform_fee
  refund
}
class TransactionStatus <<Enumeration>> {
  pending
  completed
  failed
  refunded
}
class SubscriptionStatus <<Enumeration>> {
  active
  past_due
  cancelled
  refunded
}
class EligibilitySource <<Enumeration>> {
  threshold
  admin_grant
}
class DocumentStatus <<Enumeration>> {
  pending
  extracting
  ready
  failed
}
class AiActionType <<Enumeration>> {
  chat
  inline_reformulate
  inline_shorten
  inline_expand
  inline_simplify
  inline_improve
  voice_transcribe
  portfolio_insight
}
class AnalyticsEventType <<Enumeration>> {
  view
  scroll
  time_on_page
  like
  comment
  repost
}

Article "1" -- "0..*" ArticleChunk : is chunked into
User "1" -- "0..1" WriterMemory
User "1" -- "0..1" PortfolioInsight
User "1" -- "0..*" AiInteraction
User "1" -- "0..*" Document : owns
Document "1" -- "0..*" DocumentChunk : is chunked into
Article "0..*" -- "0..*" Document : is grounded in
Article "1" -- "0..*" Purchase
User "1" -- "0..*" Purchase : buys
Purchase "0..1" -- "0..1" Purchase : prior preview
Purchase "1" -- "2..3" Transaction : records
User "1" -- "0..*" Transaction
User "1" -- "0..*" MagazineSubscription
User "1" -- "0..*" EligibilityAuditLog
Article "1" -- "0..*" AnalyticsEvent
Article "1" -- "0..1" ArticleMetrics
User "1" -- "0..1" WriterAudienceMetrics
User "1" -- "0..1" WriterContentMetrics
User "1" -- "0..1" WriterQualityMetrics

note as N1
  topCountries, deviceSplit and paragraphDropoff are
  written NULL: no client-side capture source exists.
  NULL rather than zero, so "not measured" stays
  distinguishable from "measured, and none".
end note

note as N2
  A Document is private to its owner: its chunks are
  retrieved only for the articles it is attached to,
  never for writer memory, insights or search (FR-87).
end note

' Layout: stack the leaves and group the enumerations, otherwise the
' User hub spreads the figure into a 2800px strip.
ArticleChunk -[hidden]down- WriterMemory
WriterMemory -[hidden]down- PortfolioInsight
PortfolioInsight -[hidden]down- AiInteraction
Document -[hidden]down- DocumentChunk
Purchase -[hidden]down- Transaction
Transaction -[hidden]down- MagazineSubscription
MagazineSubscription -[hidden]down- EligibilityAuditLog
AnalyticsEvent -[hidden]down- ArticleMetrics
ArticleMetrics -[hidden]down- WriterAudienceMetrics
WriterAudienceMetrics -[hidden]down- WriterContentMetrics
WriterContentMetrics -[hidden]down- WriterQualityMetrics
PurchaseStage -[hidden]down- TransactionType
TransactionType -[hidden]down- TransactionStatus
SubscriptionStatus -[hidden]down- EligibilitySource
EligibilitySource -[hidden]down- DocumentStatus
AiActionType -[hidden]down- AnalyticsEventType
PurchaseStage -[hidden]right- SubscriptionStatus
SubscriptionStatus -[hidden]right- AiActionType
@enduml
