@startuml
' Figure 6.1 – Use case diagram, Sprint 5: marketplace, subscriptions and moderation
!include ../_style.puml
skinparam nodesep 14
skinparam ranksep 65

actor "Magazine" as MA
actor "Reader" as LG
actor "Writer" as R
actor "Administrator" as AD

R -left-|> LG

rectangle {
  usecase "Sign in" as AUTH
  usecase "Upgrade to\npremium" as UPGRADE
  usecase "Subscribe as\na magazine" as SUBSCRIBE
  usecase "Grant the monthly\ncredits" as GRANT
  usecase "Top up credits" as TOPUP
  usecase "List an article on\nthe marketplace" as LIST
  usecase "Set a price" as PRICE
  usecase "Browse marketplace\narticles" as BROWSE
  usecase "Purchase an article\nexclusively" as BUY
  usecase "Unlock a preview\n(10% of the price)" as PREVIEW
  usecase "Move credits in\none transaction" as LEDGER
  usecase "View the library" as LIB
  usecase "Publish a purchased\narticle" as PUBLISH
  usecase "View earnings" as EARN
  usecase "Review the\nreport queue" as MOD
  usecase "Dismiss a report" as MOD1
  usecase "Delete an article" as MOD2
  usecase "Ban an author" as MOD3
  usecase "Grant eligibility\nmanually" as ELIG
  usecase "Manage users" as USERS
  usecase "Manage all\narticles" as ARTICLES
  usecase "Ban a user" as UBAN
  usecase "Classify content\nat publish time" as CLASSIFY
}

LG --> UPGRADE
R --> LIST
R  --> EARN
MA --> SUBSCRIBE
MA --> BROWSE
MA --> BUY
MA --> TOPUP
MA --> LIB
MA --> PUBLISH
AD --> MOD
AD --> ELIG
AD --> USERS
AD --> ARTICLES

MOD1 --|> MOD
MOD2 --|> MOD
MOD3 --|> MOD
USERS <.. UBAN : <<extend>>

SUBSCRIBE ..> GRANT : <<include>>
SUBSCRIBE ..> AUTH : <<include>>
LIST      ..> PRICE : <<include>>
LIST      ..> AUTH : <<include>>
BUY       ..> LEDGER : <<include>>
BUY       <.. PREVIEW : <<extend>>
LIB <.right. PUBLISH : <<extend>>
PUBLISH   ..> AUTH : <<include>>
PREVIEW   ..> LEDGER : <<include>>
TOPUP     ..> LEDGER : <<include>>
GRANT     ..> LEDGER : <<include>>
BROWSE    ..> AUTH : <<include>>
MOD       ..> AUTH : <<include>>
LIST      ..> CLASSIFY : <<include>>


note as N1
  Listing on the marketplace requires [writer is eligible]:
  5,000 identified readers and 1,000 reactions,
  lifetime and monotonic, or an administrator's grant.
end note

note as N2
  A full purchase is exclusive: once one magazine owns
  the article, any other is refused a preview or a
  purchase (FR-72). The owner then publishes it under
  its own masthead, public and free (FR-73).
end note
note "Browsing, purchasing, the library and\npublication need [subscription active]." as NSUB
@enduml
