        <mxCell id="note_N1" value="Listing on the marketplace requires [writer is&lt;br&gt;eligible]: 5,000 identified readers and 1,000&lt;br&gt;reactions, lifetime and monotonic, or an&lt;br&gt;administrator&#x27;s grant." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontStyle=2;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="804" width="315" height="78" as="geometry"/></mxCell>
        <mxCell id="note_N2" value="A full purchase is exclusive: once one magazine owns&lt;br&gt;the article, any other is refused a preview or a&lt;br&gt;purchase (FR-72). The owner then publishes it under&lt;br&gt;its own masthead, public and free (FR-73)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontStyle=2;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="331" y="804" width="352" height="78" as="geometry"/></mxCell>
        <mxCell id="note_NSUB" value="Browsing, purchasing, the library and publication&lt;br&gt;need [subscription active]." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontStyle=2;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="896" width="333" height="46" as="geometry"/></mxCell>
      </root>
