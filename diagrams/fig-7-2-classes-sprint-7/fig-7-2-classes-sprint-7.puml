@startuml
' Figure 7.2 – Class diagram, Sprint 7: comment likes, blocks and saves
' Three new tables (FR-60, FR-62, FR-63), drawn as many-to-many associations
' with an association class each, as in the global class diagram (fig-1-12), and the two notification
' types they emit.
' User, Article and Comment appear with only the attributes the new classes use.
!include ../_style.puml
skinparam nodesep 18
skinparam ranksep 45
hide circle
hide empty methods

class User {
  - id : UUID
  - username : String
  + likeComment(comment : Comment)
  + unlikeComment(comment : Comment)
  + block(user : User)
  + unblock(user : User)
  + save(article : Article)
  + unsave(article : Article)
  + listFollowers() : User[]
  + listFollowing() : User[]
  + listBlocked() : User[]
  + listSaved() : Article[]
}
class Article {
  - id : UUID
  - title : String
  - slug : String
  + share() : Url
}
class Comment {
  - id : UUID
  - content : Text
  + reply(content : Text) : Comment
}
class CommentLike {
  - id : UUID
  - createdAt : Timestamp
}
class Block {
  - id : UUID
  - createdAt : Timestamp
}
class Save {
  - id : UUID
  - createdAt : Timestamp
}
class Notification {
  - type : NotificationType
  - data : Json
  - isRead : Boolean
  + markRead()
}

class NotificationType <<Enumeration>> {
  ...
  comment_like
  save
}

User "0..*" -- "0..*" Comment : likes
(User, Comment) .. CommentLike
User "blocker\n0..*" -- "blocked\n0..*" User : blocks
(User, User) .. Block
User "0..*" -- "0..*" Article : saves
(User, Article) .. Save
User "1" -- "0..*" Notification : receives
Article "1" -- "0..*" Comment : carries

' Enumerations underneath; the notes are in the report's text.
Comment -[hidden]-- NotificationType
@enduml
