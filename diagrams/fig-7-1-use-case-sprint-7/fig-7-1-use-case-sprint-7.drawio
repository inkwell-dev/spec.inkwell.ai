        <mxCell id="note_N1" value="Sharing and the follower lists need no account: a&lt;br&gt;link to X, Facebook or LinkedIn, or a copied URL,&lt;br&gt;opens for anyone (FR-61, FR-65)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontStyle=2;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="0" y="486" width="333" height="62" as="geometry"/></mxCell>
        <mxCell id="note_N2" value="A block hides both accounts from each other, and the&lt;br&gt;only place to lift it is the blocker&#x27;s settings&lt;br&gt;(FR-62). Saves are private: the author is notified,&lt;br&gt;but no one else can see what a reader keeps (FR-64)." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontStyle=2;fontSize=11;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="349" y="486" width="352" height="78" as="geometry"/></mxCell>
