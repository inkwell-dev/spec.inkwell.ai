@startuml
' Global use case diagram, part 1 of 3: the visitor and the reader.
' Five actors since the supervisor's review: the premium plan is a state of
' the reader, drawn as a condition on the use cases it unlocks.
!include ../_style.puml
left to right direction
skinparam nodesep 8
skinparam ranksep 70
skinparam usecase {
  FontSize 12
}

actor "Visitor" as VIS
actor "Reader" as RDR
VIS <|-- RDR

rectangle "Inkwell.ai" {
  usecase "Browse the feed" as FEED
  usecase "Filter the feed by topic" as TOPIC
  usecase "Read an article" as READ
  usecase "Search articles and writers" as SEARCH
  usecase "View a profile" as PROFILE
  usecase "Share an article" as SHARE
  usecase "Create an account" as REGISTER
  usecase "Sign in" as SIGNIN
  usecase "Sign in with Google" as GOOGLE

  usecase "Read a premium article" as PREMIUM
  usecase "Like an article" as LIKE
  usecase "Comment on an article" as COMMENT
  usecase "Reply to a comment" as REPLY
  usecase "Like a comment" as CLIKE
  usecase "Repost an article" as REPOST
  usecase "Save an article" as SAVE
  usecase "Follow a writer" as FOLLOW
  usecase "Block an account" as BLOCK
  usecase "Report content" as REPORT
  usecase "View notifications" as NOTIF
  usecase "Edit one's profile" as EDIT
  usecase "Upgrade to premium" as UPGRADE
}

VIS -- FEED
VIS -- READ
VIS -- SEARCH
VIS -- PROFILE
VIS -- SHARE
VIS -- SIGNIN

RDR -- LIKE
RDR -- COMMENT
RDR -- CLIKE
RDR -- REPOST
RDR -- SAVE
RDR -- FOLLOW
RDR -- BLOCK
RDR -- REPORT
RDR -- NOTIF
RDR -- EDIT
RDR -- UPGRADE

FEED <.. TOPIC : <<extend>>
READ <.. PREMIUM : "<<extend>>\n[plan = premium]"
COMMENT <.. REPLY : <<extend>>
SIGNIN <.. REGISTER : <<extend>>
SIGNIN <.. GOOGLE : <<extend>>

note "Every use case of the Reader\nincludes «Sign in»." as N1
@enduml
