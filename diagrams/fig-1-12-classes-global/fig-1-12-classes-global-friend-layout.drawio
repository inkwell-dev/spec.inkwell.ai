        <UserObject label="" plantUmlData="{&#10;  &quot;data&quot;: &quot;@startuml\n' ── Style (black-and-white UML, shared by the report's figures) ──\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam defaultFontName DejaVu Sans\nskinparam defaultFontSize 12\nskinparam roundCorner 0\nskinparam ArrowColor #000000\nskinparam ArrowFontColor #000000\nskinparam ArrowFontSize 11\n\nskinparam actor {\n  BackgroundColor #FFFFFF\n  BorderColor #000000\n  FontColor #000000\n  FontStyle bold\n}\nskinparam usecase {\n  BackgroundColor #FFFFFF\n  BorderColor #000000\n  FontColor #000000\n  FontStyle bold\n  BorderThickness 1\n}\nskinparam rectangle {\n  BackgroundColor #FFFFFF\n  BorderColor #000000\n  FontColor #000000\n  FontStyle bold\n}\nskinparam class {\n  BackgroundColor #FFFFFF\n  BorderColor #000000\n  HeaderBackgroundColor #FFFFFF\n  FontColor #000000\n  AttributeFontSize 11\n  AttributeFontColor #000000\n}\nskinparam classBackgroundColor&lt;&lt;Enumeration&gt;&gt; #DAE8FC\nskinparam classAttributeIconSize 0\nskinparam sequence {\n  ArrowColor #000000\n  LifeLineBorderColor #000000\n  LifeLineBackgroundColor #FFFFFF\n  ParticipantBackgroundColor #FFFFFF\n  ParticipantBorderColor #000000\n  ParticipantFontColor #000000\n  ParticipantFontStyle bold\n  ActorBackgroundColor #FFFFFF\n  ActorBorderColor #000000\n  BoxBackgroundColor #FFFFFF\n  BoxBorderColor #000000\n  GroupBackgroundColor #FFFFFF\n  GroupBorderColor #000000\n  ReferenceBackgroundColor #FFFFFF\n  ReferenceBorderColor #000000\n  DividerBackgroundColor #FFFFFF\n  DividerBorderColor #000000\n}\nskinparam note {\n  BackgroundColor #FFF2CC\n  BorderColor #D6B656\n  FontColor #000000\n  FontSize 11\n  FontStyle italic\n}\n\nskinparam activity {\n  BackgroundColor #FFFFFF\n  BorderColor #000000\n  FontColor #000000\n  DiamondBackgroundColor #FFFFFF\n  DiamondBorderColor #000000\n  DiamondFontColor #000000\n  StartColor #000000\n  EndColor #000000\n  BarColor #000000\n}\nskinparam partition {\n  BackgroundColor #FFFFFF\n  BorderColor #000000\n  FontColor #000000\n}\n\nskinparam state {\n  BackgroundColor #FFFFFF\n  BorderColor #000000\n  FontColor #000000\n  StartColor #000000\n  EndColor #000000\n  AttributeFontColor #000000\n  AttributeFontSize 11\n}\n' ─────────────────────────────────────────────\n\n!pragma layout elk\nhide circle\nhide empty methods\n\nclass User {\n  - id : UUID\n  - accountType : AccountType\n  - email : String\n  - username : String\n  - role : Role\n  - plan : Plan\n  - earningsBalance : Integer\n  - isMarketplaceEligible : Boolean\n  - aiTokensRemaining : Integer\n  - deletedAt : Timestamp\n  + register()\n  + signIn()\n  + updateProfile()\n  + setPlan(plan : Plan)\n  + like(article : Article)\n  + unlike(article : Article)\n  + repost(article : Article)\n  + save(article : Article)\n  + follow(user : User)\n  + block(user : User)\n  + likeComment(comment : Comment)\n  + getRepresentativeChunks() : ArticleChunk[]\n  + countProgress() : Progress\n  + getMyAnalytics() : Dashboard\n}\nclass MagazineProfile {\n  - displayName : String\n  - slug : String\n  - subscriptionStatus : SubscriptionStatus\n  - creditBalance : Integer\n  - monthlyCreditAllowance : Integer\n  - subscriptionExpiresAt : Timestamp\n  + subscribe()\n  + topUp(credits : Integer)\n  + cancel()\n}\nclass Article {\n  - id : UUID\n  - publisherId : UUID\n  - title : String\n  - slug : String\n  - content : Json\n  - contentSearch : TsVector\n  - status : ArticleStatus\n  - placement : Placement\n  - visibility : Visibility\n  - marketplacePrice : Integer\n  - wordCount : Integer\n  - publishedAt : Timestamp\n  - deletedAt : Timestamp\n  + update()\n  + publish(placement : Placement, visibility : Visibility)\n  + switchToPublic()\n  + softDelete()\n  + findComments() : Comment[]\n  + publish()\n  + getArticleAnalytics() : ArticleMetrics\n}\nclass Tag {\n  - name : String\n  - slug : String\n  + findAll() : Tag[]\n  + create(name : String)\n}\nclass Comment {\n  - content : Text\n  - deletedAt : Timestamp\n  + reply(content : Text) : Comment\n  + remove()\n}\nclass Notification {\n  - type : NotificationType\n  - data : Json\n  - isRead : Boolean\n  + markRead()\n}\nclass Report {\n  - targetType : ReportTargetType\n  - targetId : UUID\n  - reason : Text\n  - status : ReportStatus\n  + resolve(action : String)\n}\nclass ArticleChunk {\n  - chunkIndex : Integer\n  - content : Text\n  - embedding : Vector\n  + embedArticle(article : Article)\n  + findSimilarChunks(query : String) : ArticleChunk[]\n}\nclass WriterMemory {\n  - tonePreferences : Json\n  - styleExamples : Json\n  - vocabularyPatterns : Json\n  - topics : Json\n  + extract()\n}\nclass PortfolioInsight {\n  - voiceSummary : Text\n  - topicExpertise : Json\n  - consistencyScore : Integer\n  - expiresAt : Timestamp\n  + generate()\n  + getCached()\n}\nclass AiInteraction {\n  - actionType : AiActionType\n  - tokensUsed : Integer\n  - model : String\n  + billAction(tokens : Integer)\n}\nclass Document {\n  - title : String\n  - filename : String\n  - sizeBytes : Integer\n  - storageKey : String\n  - status : DocumentStatus\n  - pageCount : Integer\n  - error : Text\n  - deletedAt : Timestamp\n  + register()\n  + retry()\n  + remove()\n}\nclass DocumentChunk {\n  - chunkIndex : Integer\n  - page : Integer\n  - content : Text\n  - embedding : Vector\n  + ingest(document : Document)\n  + findSimilarDocumentChunks(query : String) : DocumentChunk[]\n}\nclass Purchase {\n  - stage : PurchaseStage\n  - creditsPaid : Integer\n  - platformFee : Integer\n  - writerPayout : Integer\n  + previewUnlock()\n  + buy()\n  + publish()\n}\nclass Transaction {\n  - type : TransactionType\n  - amount : Integer\n  - idempotencyKey : String\n  - status : TransactionStatus\n  + checkLedgerInvariants() : Violation[]\n}\nclass MagazineSubscription {\n  - status : SubscriptionStatus\n  - creditsGranted : Integer\n  - expiresAt : Timestamp\n  + renew()\n}\nclass EligibilityAuditLog {\n  - source : EligibilitySource\n  - readersAt : Integer\n  - reactionsAt : Integer\n  + record(source : EligibilitySource)\n}\nclass AnalyticsEvent {\n  - eventType : AnalyticsEventType\n  - metadata : Json\n  + createEvents(batch : AnalyticsEvent[])\n}\nclass ArticleMetrics {\n  - totalViews : Integer\n  - totalUniqueViews : Integer\n  - completionRate : Float\n  - engagementRate : Float\n  - paragraphDropoff : Json\n  + aggregate()\n}\nclass WriterAudienceMetrics {\n  - totalUniqueReaders : Integer\n  - returningReaderRate : Float\n  - topCountries : Json\n  - deviceSplit : Json\n  + aggregate()\n}\nclass WriterContentMetrics {\n  - totalPublished : Integer\n  - postingFrequency : Float\n  - postingConsistency : Float\n  - topTags : Json\n  + aggregate()\n}\nclass WriterQualityMetrics {\n  - engagementRate : Float\n  - repostRate : Float\n  - commentDepth : Float\n  - retentionCurve : Json\n  + aggregate()\n}\nclass AccountType &lt;&lt;Enumeration&gt;&gt; {\n  personal\n  magazine\n}\nclass Role &lt;&lt;Enumeration&gt;&gt; {\n  reader\n  writer\n  admin\n}\nclass Plan &lt;&lt;Enumeration&gt;&gt; {\n  free\n  premium\n}\nclass ArticleStatus &lt;&lt;Enumeration&gt;&gt; {\n  draft\n  published\n}\nclass Placement &lt;&lt;Enumeration&gt;&gt; {\n  public\n  marketplace\n}\nclass Visibility &lt;&lt;Enumeration&gt;&gt; {\n  free\n  premium\n}\nclass NotificationType &lt;&lt;Enumeration&gt;&gt; {\n  follow\n  like\n  comment\n  reply\n  repost\n  article_previewed\n  article_purchased\n  earnings_credited\n  subscription_renewed\n  comment_like\n  save\n  article_published\n}\nclass ReportTargetType &lt;&lt;Enumeration&gt;&gt; {\n  article\n  user\n  comment\n}\nclass ReportStatus &lt;&lt;Enumeration&gt;&gt; {\n  pending\n  reviewed\n  resolved\n  dismissed\n}\nclass AiActionType &lt;&lt;Enumeration&gt;&gt; {\n  chat\n  inline_reformulate\n  inline_shorten\n  inline_expand\n  inline_simplify\n  inline_improve\n  voice_transcribe\n  portfolio_insight\n}\nclass DocumentStatus &lt;&lt;Enumeration&gt;&gt; {\n  pending\n  extracting\n  ready\n  failed\n}\nclass PurchaseStage &lt;&lt;Enumeration&gt;&gt; {\n  preview_unlock\n  full_purchase\n}\nclass TransactionType &lt;&lt;Enumeration&gt;&gt; {\n  subscription_charge\n  monthly_credit_grant\n  credit_topup\n  preview_unlock\n  article_full_purchase\n  writer_payout\n  platform_fee\n  refund\n}\nclass TransactionStatus &lt;&lt;Enumeration&gt;&gt; {\n  pending\n  completed\n  failed\n  refunded\n}\nclass SubscriptionStatus &lt;&lt;Enumeration&gt;&gt; {\n  active\n  past_due\n  cancelled\n  refunded\n}\nclass EligibilitySource &lt;&lt;Enumeration&gt;&gt; {\n  threshold\n  admin_grant\n}\nclass AnalyticsEventType &lt;&lt;Enumeration&gt;&gt; {\n  view\n  scroll\n  time_on_page\n  like\n  comment\n  repost\n}\n\nUser \&quot;1\&quot; -- \&quot;0..1\&quot; MagazineProfile : extends\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Article : writes\nUser \&quot;0..1\&quot; -- \&quot;0..*\&quot; Article : publishes\nArticle \&quot;0..*\&quot; -- \&quot;0..*\&quot; Tag : is tagged with\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Comment : posts\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Notification : receives\nUser \&quot;0..1\&quot; -- \&quot;0..*\&quot; Report : files\nArticle \&quot;1\&quot; -- \&quot;0..*\&quot; Comment : carries\nComment \&quot;0..1\&quot; -- \&quot;0..*\&quot; Comment : replies to\nUser \&quot;0..*\&quot; -- \&quot;0..*\&quot; Article : likes\nUser \&quot;0..*\&quot; -- \&quot;0..*\&quot; Article : reposts\nUser \&quot;0..*\&quot; -- \&quot;0..*\&quot; Article : saves\nUser \&quot;0..*\&quot; -- \&quot;0..*\&quot; Comment : likes\nUser \&quot;0..*\&quot; -- \&quot;0..*\&quot; User : follows\nUser \&quot;0..*\&quot; -- \&quot;0..*\&quot; User : blocks\nArticle \&quot;1\&quot; -- \&quot;0..*\&quot; ArticleChunk : is chunked into\nUser \&quot;1\&quot; -- \&quot;0..1\&quot; WriterMemory\nUser \&quot;1\&quot; -- \&quot;0..1\&quot; PortfolioInsight\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; AiInteraction\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Document : owns\nDocument \&quot;1\&quot; -- \&quot;0..*\&quot; DocumentChunk : is chunked into\nArticle \&quot;0..*\&quot; -- \&quot;0..*\&quot; Document : is grounded in\nArticle \&quot;1\&quot; -- \&quot;0..*\&quot; Purchase\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Purchase : buys\nPurchase \&quot;0..1\&quot; -- \&quot;0..1\&quot; Purchase : prior preview\nPurchase \&quot;1\&quot; -- \&quot;2..3\&quot; Transaction : records\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Transaction\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; MagazineSubscription\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; EligibilityAuditLog\nArticle \&quot;1\&quot; -- \&quot;0..*\&quot; AnalyticsEvent\nArticle \&quot;1\&quot; -- \&quot;0..1\&quot; ArticleMetrics\nUser \&quot;1\&quot; -- \&quot;0..1\&quot; WriterAudienceMetrics\nUser \&quot;1\&quot; -- \&quot;0..1\&quot; WriterContentMetrics\nUser \&quot;1\&quot; -- \&quot;0..1\&quot; WriterQualityMetrics\n@enduml\n&quot;,&#10;  &quot;config&quot;: null&#10;}" id="g2zIY2QBQqJksLHhMvze-1">
