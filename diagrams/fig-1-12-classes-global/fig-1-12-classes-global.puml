@startuml
' Complete class diagram, as text. Written by tools/gen-class-global.py from
' fig-1-12-classes-global.drawio and the association list in that script:
' edit the drawing (or the list), then re-run the script. Not rendered.
!include ../_style.puml
!pragma layout elk
hide circle
hide empty methods

class User {
  - id : UUID
  - accountType : AccountType
  - email : String
  - username : String
  - role : Role
  - plan : Plan
  - earningsBalance : Integer
  - isMarketplaceEligible : Boolean
  - aiTokensRemaining : Integer
  - deletedAt : Timestamp
  + register()
  + signIn()
  + updateProfile()
  + setPlan(plan : Plan)
  + like(article : Article)
  + unlike(article : Article)
  + repost(article : Article)
  + save(article : Article)
  + follow(user : User)
  + block(user : User)
  + likeComment(comment : Comment)
  + getRepresentativeChunks() : ArticleChunk[]
  + countProgress() : Progress
  + getMyAnalytics() : Dashboard
}

class MagazineProfile {
  - displayName : String
  - slug : String
  - subscriptionStatus : SubscriptionStatus
  - creditBalance : Integer
  - monthlyCreditAllowance : Integer
  - subscriptionExpiresAt : Timestamp
  + subscribe()
  + topUp(credits : Integer)
  + cancel()
}

class Article {
  - id : UUID
  - publisherId : UUID
  - title : String
  - slug : String
  - content : Json
  - searchVector : TsVector
  - status : ArticleStatus
  - placement : Placement
  - visibility : Visibility
  - marketplacePrice : Integer
  - wordCount : Integer
  - publishedAt : Timestamp
  - deletedAt : Timestamp
  + update()
  + publish(placement : Placement, visibility : Visibility)
  + switchToPublic()
  + softDelete()
  + findComments() : Comment[]
  + publish()
  + getArticleAnalytics() : ArticleMetrics
}

class Tag {
  - name : String
  - slug : String
  + findAll() : Tag[]
  + create(name : String)
}

class Comment {
  - content : Text
  - parentId : UUID
  - deletedAt : Timestamp
  + reply(content : Text) : Comment
  + remove()
}

class Notification {
  - type : NotificationType
  - data : Json
  - isRead : Boolean
  + markRead()
}

class Report {
  - targetType : ReportTargetType
  - targetId : UUID
  - reason : Text
  - status : ReportStatus
  + resolve(action : String)
}

class ArticleChunk {
  - chunkIndex : Integer
  - content : Text
  - embedding : Vector
  + embedArticle(article : Article)
  + findSimilarChunks(query : String) : ArticleChunk[]
}

class WriterMemory {
  - tonePreferences : Json
  - styleExamples : Json
  - vocabularyPatterns : Json
  - topics : Json
  + extract()
}

class PortfolioInsight {
  - voiceSummary : Text
  - topicExpertise : Json
  - consistencyScore : Integer
  - expiresAt : Timestamp
  + generate()
  + getCached()
}

class AiInteraction {
  - actionType : AiActionType
  - tokensUsed : Integer
  - model : String
  + billAction(tokens : Integer)
}

class Document {
  - title : String
  - filename : String
  - sizeBytes : Integer
  - storageKey : String
  - status : DocumentStatus
  - pageCount : Integer
  - error : Text
  - deletedAt : Timestamp
  + register()
  + retry()
  + remove()
}

class DocumentChunk {
  - chunkIndex : Integer
  - page : Integer
  - content : Text
  - embedding : Vector
  + ingest(document : Document)
  + findSimilarDocumentChunks(query : String) : DocumentChunk[]
}

class Purchase {
  - stage : PurchaseStage
  - creditsPaid : Integer
  - platformFee : Integer
  - writerPayout : Integer
  + previewUnlock()
  + buy()
  + publish()
}

class Transaction {
  - type : TransactionType
  - amount : Integer
  - idempotencyKey : String
  - status : TransactionStatus
  + checkLedgerInvariants() : Violation[]
}

class MagazineSubscription {
  - status : SubscriptionStatus
  - creditsGranted : Integer
  - expiresAt : Timestamp
  + renew()
}

class EligibilityAuditLog {
  - source : EligibilitySource
  - readersAt : Integer
  - reactionsAt : Integer
  + record(source : EligibilitySource)
}

class AnalyticsEvent {
  - eventType : AnalyticsEventType
  - metadata : Json
  + createEvents(batch : AnalyticsEvent[])
}

class ArticleMetrics {
  - totalViews : Integer
  - totalUniqueViews : Integer
  - completionRate : Float
  - engagementRate : Float
  - paragraphDropoff : Json
  + aggregate()
}

class WriterAudienceMetrics {
  - totalUniqueReaders : Integer
  - returningReaderRate : Float
  - topCountries : Json
  - deviceSplit : Json
  + aggregate()
}

class WriterContentMetrics {
  - totalPublished : Integer
  - postingFrequency : Float
  - postingConsistency : Float
  - topTags : Json
  + aggregate()
}

class WriterQualityMetrics {
  - engagementRate : Float
  - repostRate : Float
  - commentDepth : Float
  - retentionCurve : Json
  + aggregate()
}

enum AccountType {
  personal
  magazine
}

enum Role {
  reader
  writer
  admin
}

enum Plan {
  free
  premium
}

enum ArticleStatus {
  draft
  published
}

enum Placement {
  public
  marketplace
}

enum Visibility {
  free
  premium
}

enum NotificationType {
  follow
  like
  comment
  reply
  repost
  article_previewed
  article_purchased
  earnings_credited
  subscription_renewed
  comment_like
  save
  article_published
}

enum ReportTargetType {
  article
  user
  comment
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

enum AiActionType {
  chat
  inline_reformulate
  inline_shorten
  inline_expand
  inline_simplify
  inline_improve
  voice_transcribe
  portfolio_insight
}

enum DocumentStatus {
  pending
  extracting
  ready
  failed
}

enum PurchaseStage {
  preview_unlock
  full_purchase
}

enum TransactionType {
  subscription_charge
  monthly_credit_grant
  credit_topup
  preview_unlock
  article_full_purchase
  writer_payout
  platform_fee
  refund
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
  refunded
}

enum EligibilitySource {
  threshold
  admin_grant
}

enum AnalyticsEventType {
  view
  scroll
  time_on_page
  like
  comment
  repost
}

class Repost {
  - id : UUID
  - createdAt : Timestamp
}

class Save {
  - id : UUID
  - createdAt : Timestamp
}

class ArticleTag {
  - articleId : UUID
  - tagId : UUID
}

class Block {
  - id : UUID
  - createdAt : Timestamp
}

class Follow {
  - id : UUID
  - createdAt : Timestamp
}

class CommentLike {
  - id : UUID
  - createdAt : Timestamp
}

class ArticleDocument {
  - articleId : UUID
  - documentId : UUID
  - createdAt : Timestamp
}

class Like {
  - id : UUID
  - createdAt : Timestamp
}

User "1" -- "0..1" MagazineProfile : extends
User "1" -- "0..*" Article : writes
