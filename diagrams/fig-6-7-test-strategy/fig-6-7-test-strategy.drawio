<mxfile host="Electron" type="device">
  <diagram id="fig-6-7-test-strategy" name="Figure 6.7 - Test strategy">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="730" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="e2e" value="End-to-end&lt;br&gt;155 Playwright specs, 23 files&lt;br&gt;real browser, seeded corpus" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="int" value="Integration through the API&lt;br&gt;auth → publish → purchase → verify the ledger" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="310" y="240" width="560" height="90" as="geometry"/></mxCell>
        <mxCell id="unit" value="Unit and service tests&lt;br&gt;the bulk of 479 backend tests, run against a real PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="220" y="360" width="740" height="90" as="geometry"/></mxCell>
        <mxCell id="ledger" value="Ledger invariant harness&lt;br&gt;&lt;br&gt;27 tests, most of them&lt;br&gt;negative: a fixture builds&lt;br&gt;a coherent purchase, then&lt;br&gt;corrupts one column and&lt;br&gt;asserts the right invariant fires" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="sweep" value="Price sweep&lt;br&gt;&lt;br&gt;every value from 1 to 300,&lt;br&gt;both stages and both splits,&lt;br&gt;reconciled exactly" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="400" y="500" width="280" height="170" as="geometry"/></mxCell>
        <mxCell id="gates" value="CI gates — a red build blocks the image" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="120" width="200" height="330" as="geometry"/></mxCell>
        <mxCell id="g1" value="eslint, 0 warnings" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020" y="170" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="g2" value="tsc --noEmit" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020" y="220" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="g3" value="the test suites" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020" y="270" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="g4" value="schema-drift check" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1020" y="320" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="g5" value="build and push" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020" y="370" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="note" value="Validated by sabotage, not by passing: removing the completed-status filter from the earnings query fails exactly the pending-payout test, and dropping preview_unlock from the debit list fails seven. That exercise found a real coverage gap — nothing pinned the grant type filter — which was then closed." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="720" y="500" width="480" height="170" as="geometry"/></mxCell>
        <mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="unit" target="int"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="int" target="e2e"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
