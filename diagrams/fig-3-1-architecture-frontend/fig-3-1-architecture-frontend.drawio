<mxfile host="Electron" type="device">
  <diagram id="fig-3-1-architecture-frontend" name="Figure 3.1 - Logical frontend architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="browser" value="Browser" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="20" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="fe" value="Frontend — Next.js 16, App Router" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="1140" height="380" as="geometry"/></mxCell>
        <mxCell id="routes" value="Routes (app/) — 28 pages&lt;br&gt;&lt;br&gt;/ · /articles/[slug] · /search&lt;br&gt;/editor/[id] · /dashboard/*&lt;br&gt;/following · /saved · /library&lt;br&gt;/discover · /marketplace · /m/[slug]&lt;br&gt;/u/[username] · /settings · /admin" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="features" value="Features (features/) — 18 modules&lt;br&gt;&lt;br&gt;editor — TipTap · inline actions&lt;br&gt;ai — docked panel, voice,&lt;br&gt;document sources&lt;br&gt;documents · saves · reposts&lt;br&gt;marketplace · evaluation&lt;br&gt;notifications · moderation" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="150" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="state" value="State and data&lt;br&gt;&lt;br&gt;React Query&lt;br&gt;Zustand&lt;br&gt;axios interceptors&lt;br&gt;401 → refresh → retry&lt;br&gt;analytics tracker (lib/)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="mw" value="Request proxy (proxy.ts)&lt;br&gt;&lt;br&gt;route protection&lt;br&gt;before the page renders" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="910" y="150" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="sse" value="SSE client — EventSource, live notifications" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="100" y="330" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="upload" value="Direct upload — browser PUTs to presigned URL" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="be" value="Backend — NestJS 11" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="400" y="560" width="400" height="60" as="geometry"/></mxCell>
        <mxCell id="store" value="Object storage — MinIO" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="900" y="560" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="fe"><mxGeometry relative="1" as="geometry"/></mxCell>
