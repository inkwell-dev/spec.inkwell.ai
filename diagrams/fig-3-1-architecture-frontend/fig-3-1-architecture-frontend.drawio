        <mxCell id="c2" value="Frontend: Next.js 16, App Router" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=20;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="780" height="470" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Routes (app/): 28 pages&lt;/b&gt;&lt;br&gt;/ · /articles/[slug] · /search&lt;br&gt;/editor/[id] · /dashboard/*&lt;br&gt;/following · /saved · /library&lt;br&gt;/discover · /marketplace&lt;br&gt;/m/[slug] · /u/[username]&lt;br&gt;/settings · /admin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="15" y="135" width="365" height="200" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Features (features/): 18 modules&lt;/b&gt;&lt;br&gt;editor: TipTap · inline actions&lt;br&gt;ai: docked panel, voice, document sources&lt;br&gt;documents · saves · reposts&lt;br&gt;marketplace · evaluation&lt;br&gt;notifications · moderation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="135" width="365" height="200" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Request proxy (proxy.ts): route protection before the page renders&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="15" y="350" width="750" height="50" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;SSE client&lt;/b&gt;&lt;br&gt;EventSource,&lt;br&gt;live notifications" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="15" y="415" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;State and data&lt;/b&gt;&lt;br&gt;React Query · Zustand&lt;br&gt;axios interceptors&lt;br&gt;401 → refresh → retry&lt;br&gt;analytics tracker (lib/)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="415" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;Direct upload&lt;/b&gt;&lt;br&gt;the browser PUTs the file&lt;br&gt;to a presigned URL" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="525" y="415" width="240" height="130" as="geometry"/></mxCell>
