@startuml
' Global use case diagram, all actors.
' Maintained by hand: the figure is the .drawio beside this file, laid out in
' draw.io, and this file records the same content as text. Edit both together.
' Neither is regenerated by `make regen` any more.
!include ../_style.puml
actor "Visitor" as VIS
actor "Reader" as RDR
actor "Writer" as WRT
actor "Magazine" as MAG
actor "Administrator" as ADM
VIS <|-- RDR
RDR <|-- WRT
rectangle "Inkwell.ai" {
  ' Shared by every authenticated use case, drawn as an explicit «include»
  usecase "Sign in" as SIGNIN

  ' Visitor
  usecase "Browse the feed" as V_FEED
  usecase "Filter topic" as V_TOPIC
  usecase "Search articles and writers" as V_SEARCH
  usecase "View writer's profile" as V_PROFILE
  usecase "Read an article" as V_READ
  usecase "Share an article" as V_SHARE
  usecase "Create an account" as V_REGISTER
  usecase "Sign in with Google" as V_GOOGLE

  ' Reader
  usecase "Manage articles" as R_ARTICLES
  usecase "Like" as R_LIKE
  usecase "Comment" as R_COMMENT
  usecase "Repost" as R_REPOST
  usecase "Save" as R_SAVE
  usecase "Report" as R_REPORT
  usecase "Manage comments" as R_COMMENTS
  usecase "Create" as R_CCREATE
  usecase "Reply" as R_CREPLY
  usecase "Like" as R_CLIKE
  usecase "Delete" as R_CDELETE
  usecase "Interact with a profile" as R_PROFILE
  usecase "Block" as R_BLOCK
  usecase "Follow" as R_FOLLOW
  usecase "View notifications" as R_NOTIF
  usecase "Edit my profile" as R_EDIT
  usecase "Manage subscription" as R_SUB
  usecase "Read a premium article" as R_PREMIUM

  ' Writer
  usecase "Manage my articles" as W_ARTICLES
  usecase "Create" as W_CREATE
  usecase "Edit" as W_EDIT
  usecase "Publish" as W_PUBLISH
  usecase "Choose publish type" as W_PLACE
  usecase "Delete" as W_DELETE
  usecase "Ask the assistant" as W_ASK
  usecase "Apply an inline action" as W_INLINE
  usecase "Upload a reference document" as W_UPLOAD
  usecase "Consume the AI allowance" as W_QUOTA
  usecase "View my profile analytics" as W_STATS
  usecase "View earnings" as W_EARN

  ' Magazine
  usecase "Manage subscription" as M_SUB
  usecase "View balance and transactions" as M_BALANCE
  usecase "Top up credits" as M_TOPUP
  usecase "Browse writers" as M_WRITERS
  usecase "Read a writer evaluation" as M_EVAL
  usecase "Generate portfolio insights" as M_INSIGHTS
  usecase "Browse the marketplace" as M_MARKET
  usecase "Unlock a preview" as M_PREVIEW
  usecase "Purchase an article" as M_BUY
  usecase "View the library" as M_LIBRARY
  usecase "Publish a licensed article" as M_PUBLISH

  ' Administrator
  usecase "Manage reports" as A_REPORTS
  usecase "Dismiss" as A_DISMISS
  usecase "Delete an article" as A_REMOVE
  usecase "Ban an author" as A_BAN
  usecase "Manage users" as A_USERS
  usecase "Grant eligibility" as A_GRANT
  usecase "Change a user's plan" as A_PLAN
  usecase "Ban a user" as A_UDELETE
  usecase "Manage all articles" as A_ARTICLES
  usecase "Delete" as A_ADELETE
}

' Visitor: needs no account
VIS -- V_FEED
VIS -- V_READ
VIS -- V_REGISTER
V_FEED <.. V_TOPIC : <<extend>>
V_FEED <.. V_SEARCH : <<extend>>
V_FEED <.. V_PROFILE : <<extend>>
V_READ <.. V_SHARE : <<extend>>
V_REGISTER <.. V_GOOGLE : <<extend>>

' Reader
RDR -- R_ARTICLES
RDR -- R_COMMENTS
RDR -- R_PROFILE
RDR -- R_NOTIF
RDR -- R_EDIT
RDR -- R_SUB
R_ARTICLES <.. R_LIKE : <<extend>>
R_ARTICLES <.. R_COMMENT : <<extend>>
R_ARTICLES <.. R_REPOST : <<extend>>
R_ARTICLES <.. R_SAVE : <<extend>>
R_ARTICLES <.. R_REPORT : <<extend>>
R_COMMENTS <.. R_CCREATE : <<extend>>
R_COMMENTS <.. R_CREPLY : <<extend>>
R_COMMENTS <.. R_CLIKE : <<extend>>
R_COMMENTS <.. R_CDELETE : <<extend>>
R_PROFILE <.. R_BLOCK : <<extend>>
R_PROFILE <.. R_FOLLOW : <<extend>>
R_PREMIUM <.. R_SUB : <<extend>>
R_ARTICLES ..> SIGNIN : <<include>>
R_COMMENTS ..> SIGNIN : <<include>>
R_PROFILE ..> SIGNIN : <<include>>
R_NOTIF ..> SIGNIN : <<include>>
R_EDIT ..> SIGNIN : <<include>>
R_SUB ..> SIGNIN : <<include>>

' Writer
WRT -- W_ARTICLES
WRT -- W_STATS
WRT -- W_EARN
W_ARTICLES <.. W_CREATE : <<extend>>
W_ARTICLES <.. W_EDIT : <<extend>>
W_ARTICLES <.. W_PUBLISH : <<extend>>
W_ARTICLES <.. W_DELETE : <<extend>>
W_PUBLISH ..> W_PLACE : <<include>>
W_CREATE <.. W_ASK : <<extend>>
W_EDIT <.. W_ASK : <<extend>>
W_CREATE <.. W_INLINE : <<extend>>
W_EDIT <.. W_INLINE : <<extend>>
W_ASK <.. W_UPLOAD : <<extend>>
W_ASK ..> W_QUOTA : <<include>>
W_INLINE ..> W_QUOTA : <<include>>
W_ARTICLES ..> SIGNIN : <<include>>
W_STATS ..> SIGNIN : <<include>>
W_EARN ..> SIGNIN : <<include>>

' Magazine
MAG -- M_SUB
MAG -- M_TOPUP
MAG -- M_WRITERS
MAG -- M_MARKET
MAG -- M_LIBRARY
M_SUB <.. M_BALANCE : <<extend>>
M_WRITERS <.. M_EVAL : <<extend>>
M_WRITERS <.. M_INSIGHTS : <<extend>>
M_MARKET <.. M_PREVIEW : <<extend>>
M_MARKET <.. M_BUY : <<extend>>
M_LIBRARY <.. M_PUBLISH : <<extend>>
M_SUB ..> SIGNIN : <<include>>
M_TOPUP ..> SIGNIN : <<include>>
M_WRITERS ..> SIGNIN : <<include>>
M_MARKET ..> SIGNIN : <<include>>
M_LIBRARY ..> SIGNIN : <<include>>

' Administrator
ADM -- A_REPORTS
ADM -- A_USERS
ADM -- A_ARTICLES
A_REPORTS <.. A_DISMISS : <<extend>>
A_REPORTS <.. A_REMOVE : <<extend>>
A_REPORTS <.. A_BAN : <<extend>>
A_USERS <.. A_GRANT : <<extend>>
A_USERS <.. A_PLAN : <<extend>>
A_USERS <.. A_UDELETE : <<extend>>
A_ARTICLES <.. A_ADELETE : <<extend>>
A_REPORTS ..> SIGNIN : <<include>>
A_USERS ..> SIGNIN : <<include>>
A_ARTICLES ..> SIGNIN : <<include>>
@enduml
