@startuml
' Global use case diagram, all actors: generated by
' tools/gen-global-figures.py from fig-1-3, fig-1-4 and fig-1-5. Edit those.
!include ../_style.puml
actor "Visitor" as VIS
actor "Reader" as RDR
actor "Writer" as WRT
actor "Magazine" as MAG
actor "Administrator" as ADM
VIS <|-- RDR
RDR <|-- WRT
rectangle "Inkwell.ai" {
  usecase "Browse the feed" as V_FEED
  usecase "Filter the feed by topic" as V_TOPIC
  usecase "Read an article" as V_READ
  usecase "Search articles and writers" as V_SEARCH
  usecase "View a profile" as V_PROFILE
  usecase "Share an article" as V_SHARE
  usecase "Create an account" as V_REGISTER
  usecase "Sign in" as V_SIGNIN
  usecase "Sign in with Google" as V_GOOGLE
  usecase "Read a premium article" as V_PREMIUM
  usecase "Like an article" as V_LIKE
  usecase "Comment on an article" as V_COMMENT
  usecase "Reply to a comment" as V_REPLY
  usecase "Like a comment" as V_CLIKE
  usecase "Repost an article" as V_REPOST
  usecase "Save an article" as V_SAVE
  usecase "Follow a writer" as V_FOLLOW
  usecase "Block an account" as V_BLOCK
  usecase "Report content" as V_REPORT
  usecase "View notifications" as V_NOTIF
  usecase "Edit one's profile" as V_EDIT
  usecase "Upgrade to premium" as V_UPGRADE
  usecase "Create a draft" as W_DRAFT
  usecase "Edit a draft" as W_EDIT
  usecase "Save the draft automatically" as W_AUTOSAVE
  usecase "Insert an image" as W_IMAGE
  usecase "Publish an article" as W_PUBLISH
  usecase "Choose placement and visibility" as W_PLACE
  usecase "Publish as premium" as W_PREMIUM
  usecase "List on the marketplace" as W_LIST
  usecase "Withdraw a listing to public" as W_WITHDRAW
  usecase "Delete an article" as W_DELETE
  usecase "Ask the assistant" as W_ASK
  usecase "Apply an inline action" as W_INLINE
  usecase "Have the assistant write into the draft" as W_WRITE
  usecase "Keep or discard a write" as W_KEEP
  usecase "Dictate a prompt" as W_DICTATE
  usecase "Hear the reply read aloud" as W_HEAR
  usecase "Consume the AI allowance" as W_QUOTA
  usecase "Upload a reference document" as W_UPLOAD
  usecase "Attach a document to an article" as W_ATTACH
  usecase "Cite a document by page" as W_CITE
  usecase "View article analytics" as W_STATS
  usecase "View eligibility progress" as W_ELIG
  usecase "View earnings" as W_EARN
  usecase "Subscribe" as M_SUB
  usecase "Top up credits" as M_TOPUP
  usecase "Cancel the subscription" as M_CANCEL
  usecase "View balance and transactions" as M_BALANCE
  usecase "Browse writers" as M_WRITERS
  usecase "Read a writer evaluation" as M_EVAL
  usecase "Generate portfolio insights" as M_INSIGHTS
  usecase "Browse the marketplace" as M_MARKET
  usecase "Purchase an article" as M_BUY
  usecase "Unlock a preview" as M_PREVIEW
  usecase "View the library" as M_LIBRARY
  usecase "Publish a licensed article" as M_PUBLISH
  usecase "Check the active subscription" as M_ACTIVE
  usecase "Review the report queue" as M_QUEUE
  usecase "Dismiss a report" as M_DISMISS
  usecase "Remove an article" as M_REMOVE
  usecase "Ban an author" as M_BAN
  usecase "Search users" as M_USERS
  usecase "Change a user's plan" as M_PLAN
  usecase "Grant eligibility" as M_GRANT
}
VIS -- V_FEED
VIS -- V_READ
VIS -- V_SEARCH
VIS -- V_PROFILE
VIS -- V_SHARE
VIS -- V_SIGNIN
RDR -- V_LIKE
RDR -- V_COMMENT
RDR -- V_CLIKE
RDR -- V_REPOST
RDR -- V_SAVE
RDR -- V_FOLLOW
RDR -- V_BLOCK
RDR -- V_REPORT
RDR -- V_NOTIF
RDR -- V_EDIT
RDR -- V_UPGRADE
V_FEED <.. V_TOPIC : <<extend>>
V_READ <.. V_PREMIUM : "<<extend>>\n[plan = premium]"
V_COMMENT <.. V_REPLY : <<extend>>
V_SIGNIN <.. V_REGISTER : <<extend>>
V_SIGNIN <.. V_GOOGLE : <<extend>>
WRT -- W_DRAFT
WRT -- W_EDIT
WRT -- W_IMAGE
WRT -- W_PUBLISH
WRT -- W_WITHDRAW
WRT -- W_DELETE
WRT -- W_ASK
WRT -- W_INLINE
WRT -- W_KEEP
WRT -- W_UPLOAD
WRT -- W_ATTACH
WRT -- W_STATS
WRT -- W_ELIG
WRT -- W_EARN
W_EDIT ..> W_AUTOSAVE : <<include>>
W_PUBLISH ..> W_PLACE : <<include>>
W_PUBLISH <.. W_PREMIUM : "<<extend>>\n[writer is eligible]"
W_PUBLISH <.. W_LIST : "<<extend>>\n[writer is eligible]"
W_ASK <.. W_WRITE : <<extend>>
W_KEEP ..> W_WRITE : <<include>>
W_ASK <.. W_DICTATE : <<extend>>
W_ASK <.. W_HEAR : <<extend>>
W_ASK <.. W_CITE : "<<extend>>\n[documents attached]"
W_ASK ..> W_QUOTA : <<include>>
W_INLINE ..> W_QUOTA : <<include>>
MAG -- M_SUB
MAG -- M_TOPUP
MAG -- M_CANCEL
MAG -- M_BALANCE
MAG -- M_WRITERS
MAG -- M_EVAL
MAG -- M_MARKET
MAG -- M_BUY
MAG -- M_LIBRARY
MAG -- M_PUBLISH
M_EVAL <.. M_INSIGHTS : <<extend>>
M_BUY <.. M_PREVIEW : <<extend>>
M_WRITERS ..> M_ACTIVE : <<include>>
M_EVAL ..> M_ACTIVE : <<include>>
M_MARKET ..> M_ACTIVE : <<include>>
M_BUY ..> M_ACTIVE : <<include>>
ADM -- M_QUEUE
ADM -- M_USERS
ADM -- M_PLAN
ADM -- M_GRANT
M_QUEUE <.. M_DISMISS : <<extend>>
M_QUEUE <.. M_REMOVE : <<extend>>
M_QUEUE <.. M_BAN : <<extend>>
note as N1
  Every use case of the Reader, the Writer, the Magazine and the
  Administrator includes «Sign in».
  The assistant needs the premium plan: «Consume the AI allowance»
  has the condition [plan = premium].
  The administrator role is granted in the database, never through
  the interface.
end note
@enduml
