<mxfile host="Electron" type="device">
  <diagram id="fig-1-1-scrum-framework" name="Figure 1.1 - The Scrum framework as practised">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="pb" value="Product backlog&lt;br&gt;&lt;br&gt;54 user stories in 8 epics,&lt;br&gt;ordered by MoSCoW priority,&lt;br&gt;estimated in story points" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="plan" value="Sprint planning&lt;br&gt;&lt;br&gt;pull the next slice,&lt;br&gt;set the sprint goal" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="340" y="120" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="sb" value="Sprint backlog&lt;br&gt;&lt;br&gt;the stories committed&lt;br&gt;for this sprint" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="340" y="280" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="sprint" value="Sprint — two weeks" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;arcSize=4;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="540" height="320" as="geometry"/></mxCell>
        <mxCell id="work" value="Daily work&lt;br&gt;&lt;br&gt;build · test · integrate&lt;br&gt;continuously" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="inc" value="Increment&lt;br&gt;&lt;br&gt;verified against the&lt;br&gt;phase exit criteria" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="review" value="Sprint review" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="retro" value="Retrospective" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="roles" value="The three Scrum roles, and how they collapse here&lt;br&gt;&lt;br&gt;Product Owner · Scrum Master · Development Team — on this project all three are the same person. The academic supervisor acts as Product Owner at sprint boundaries: scope was re-baselined twice on that basis, on 2026-07-26 and 2026-08-10. Stated in §1.4.2 rather than left implied, because it is the first thing an examiner asks about a solo Scrum project." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="1080" height="130" as="geometry"/></mxCell>
        <mxCell id="a1" value="highest priority first" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pb" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="plan" target="sb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sb" target="sprint"><mxGeometry relative="1" as="geometry"/></mxCell>
