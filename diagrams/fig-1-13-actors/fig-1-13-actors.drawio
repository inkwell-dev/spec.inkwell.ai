<mxfile host="Electron" type="device">
  <diagram id="fig-1-13-actors" name="Actors of the system">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;i&gt;no account&lt;/i&gt;&lt;br&gt;&lt;br&gt;•&amp;nbsp;browses the public feed&lt;br&gt;•&amp;nbsp;reads free articles&lt;br&gt;•&amp;nbsp;cannot interact" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=58;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="220" height="225" as="geometry"/></mxCell>
        <mxCell id="c2" value="A1&amp;nbsp;&amp;nbsp;Visitor" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=19;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="220" height="46" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;i&gt;personal account&lt;/i&gt;&lt;br&gt;&lt;br&gt;•&amp;nbsp;likes, comments, reposts&lt;br&gt;•&amp;nbsp;saves, follows, blocks&lt;br&gt;•&amp;nbsp;reports content&lt;br&gt;•&amp;nbsp;premium plan: premium&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;articles and the assistant" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=58;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="0" width="220" height="225" as="geometry"/></mxCell>
        <mxCell id="c4" value="A2&amp;nbsp;&amp;nbsp;Reader" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=19;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="0" width="220" height="46" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;i&gt;personal account, role writer&lt;/i&gt;&lt;br&gt;&lt;br&gt;•&amp;nbsp;everything a reader does&lt;br&gt;•&amp;nbsp;drafts, publishes and&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;analyses own articles&lt;br&gt;•&amp;nbsp;once eligible: premium&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;articles and listings" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=58;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="0" width="220" height="225" as="geometry"/></mxCell>
        <mxCell id="c6" value="A3&amp;nbsp;&amp;nbsp;Writer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=19;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="0" width="220" height="46" as="geometry"/></mxCell>
        <mxCell id="c7" value="signs up" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;jumpStyle=arc;jumpSize=10;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell>
        <mxCell id="c8" value="role writer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;jumpStyle=arc;jumpSize=10;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-30" as="offset"/></mxGeometry></mxCell>
        <mxCell id="c9" value="a different account type: inherits nothing" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="280" height="30" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;i&gt;magazine account&lt;/i&gt;&lt;br&gt;&lt;br&gt;•&amp;nbsp;subscribes and receives monthly credits&lt;br&gt;•&amp;nbsp;browses writers and their evaluation reports&lt;br&gt;•&amp;nbsp;previews, buys and publishes licensed articles" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=58;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="360" height="195" as="geometry"/></mxCell>
        <mxCell id="c11" value="A4&amp;nbsp;&amp;nbsp;Magazine" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=19;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="360" height="46" as="geometry"/></mxCell>
        <mxCell id="c12" value="a role granted in the database" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="460" y="260" width="280" height="30" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;i&gt;personal account, role admin&lt;/i&gt;&lt;br&gt;&lt;br&gt;•&amp;nbsp;works the report queue&lt;br&gt;•&amp;nbsp;manages users and articles&lt;br&gt;•&amp;nbsp;grants marketplace eligibility manually&lt;br&gt;•&amp;nbsp;works in a console of its own" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;spacingTop=58;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="360" height="195" as="geometry"/></mxCell>
        <mxCell id="c14" value="A5&amp;nbsp;&amp;nbsp;Administrator" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=19;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="360" height="46" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b&gt;States, not actors&lt;/b&gt;&lt;br&gt;a reader’s plan (free or premium)&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;a writer’s marketplace eligibility&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;a magazine’s subscription (active or not)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="515" width="780" height="60" as="geometry"/></mxCell>
      </root>
