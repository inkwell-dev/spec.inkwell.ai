@startuml
' Figure 7.8 – Class diagram, Sprint 9: the document library
' Three new tables (FR-84, FR-85) and the DocumentStatus enumeration; the
' article–document attachment is a many-to-many association (a join table).
' Source: src/database/schema/documents.ts.
!include ../_style.puml
skinparam nodesep 18
skinparam ranksep 45
hide circle
hide empty methods

class User {
  - id : UUID
  + listDocuments() : Document[]
}
class Article {
  - id : UUID
  - authorId : UUID
  + setDocuments(documents : Document[])
  + listDocuments() : Document[]
}
class Document {
  - id : UUID
  - title : String
  - filename : String
  - contentType : String
  - sizeBytes : Integer
  - storageKey : String
  - status : DocumentStatus
  - pageCount : Integer
  - chunkCount : Integer
  - error : Text
  - createdAt : Timestamp
  - deletedAt : Timestamp
  + register()
  + retry()
  + remove()
  + fileUrl() : String
}
class DocumentChunk {
  - chunkIndex : Integer
  - page : Integer
  - content : Text
  - embedding : Vector
  + ingest(document : Document)
  + findSimilarDocumentChunks(query : String) : DocumentChunk[]
}

class DocumentStatus <<Enumeration>> {
  pending
  extracting
  ready
  failed
}

User "1" -- "0..20" Document : owns
Document "1" -- "0..*" DocumentChunk : is chunked into
Article "0..*" -- "0..*" Document : is grounded in

note as N1
  pending → extracting → ready, or failed with a
  writer-readable reason in error. Nothing moves
  backwards except a retry, which puts a failed
  document back to pending.
end note

note as N2
  Each chunk keeps the page it came from, which is
  what a citation [Title, p. N] points at. Deleting
  a document removes its chunks and attachments
  with it (ON DELETE CASCADE).
end note
@enduml
