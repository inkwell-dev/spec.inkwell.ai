@startuml
' Figure 6.4 – Activity diagram: the marketplace eligibility gate
!include ../_style.puml

start
partition "Scheduled worker, every 20 minutes" {
  :Select writers who are not yet eligible\nand have at least one published public article;
  note right
    Writers with no published public article are
    provably at zero on both counts. Excluding them
    took this sweep from 22 minutes to 15 seconds.
  end note
  while (another candidate?) is (yes)
    :Count distinct identified readers\nacross the writer's public articles;
    note right
      Anonymous views carry no viewer id and cannot
      count toward a tally of people, so the real bar
      is 5,000 *identified* readers.
    end note
    :Count reactions: likes plus comments;
    if (readers >= 5,000 and reactions >= 1,000?) then (yes)
      :Set is_marketplace_eligible;
      :Record the timestamp and source = threshold;
      :Append a row to the eligibility audit log\nwith both metric snapshots;
    else (no)
      :Leave the writer ineligible;
    endif
  endwhile (no more)
}

partition "Administrator, on request" {
  if (an administrator grants eligibility?) then (yes)
    :Set is_marketplace_eligible;
    :Record source = admin_grant and the granting administrator;
    :Append a row to the eligibility audit log;
  else (no)
  endif
}

:Eligibility is never revoked automatically;
note right
  The threshold is a lifetime sum, so the flag is
  monotonic. Revocation is possible only through an
  explicit administrative action, which the MVP does
  not model.
end note
stop
@enduml
