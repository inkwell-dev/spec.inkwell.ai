<mxfile host="Electron" type="device">
  <diagram id="fig-3-4-architecture-cicd" name="CI/CD pipeline">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b&gt;Push to main&lt;/b&gt;&lt;br&gt;backend.inkwell.ai or frontend.inkwell.ai" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="230" y="0" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="c2" value="GitHub Actions: continuous integration" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontStyle=1;fontSize=20;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="100" width="780" height="250" as="geometry"/></mxCell>
        <mxCell id="c3" value="1. Install dependencies (pnpm)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="15" y="145" width="370" height="55" as="geometry"/></mxCell>
        <mxCell id="c4" value="2. Lint: eslint --max-warnings=0" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="15" y="210" width="370" height="55" as="geometry"/></mxCell>
        <mxCell id="c5" value="3. Typecheck: tsc --noEmit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="15" y="275" width="370" height="55" as="geometry"/></mxCell>
        <mxCell id="c6" value="4. Test: 796 backend tests" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="145" width="370" height="55" as="geometry"/></mxCell>
        <mxCell id="c7" value="5. Schema-drift check" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="210" width="370" height="55" as="geometry"/></mxCell>
        <mxCell id="c8" value="6. Build the multi-stage image" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="275" width="370" height="55" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;GHCR&lt;/b&gt;&lt;br&gt;images tagged latest and git SHA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="410" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;repository_dispatch&lt;/b&gt;&lt;br&gt;to docker.inkwell.ai" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="410" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="c11" value="Deploy workflow: docker.inkwell.ai" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontStyle=1;fontSize=20;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="540" width="780" height="250" as="geometry"/></mxCell>
        <mxCell id="c12" value="1. SSH to the VPS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="15" y="585" width="370" height="55" as="geometry"/></mxCell>
        <mxCell id="c13" value="2. docker compose pull" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="15" y="650" width="370" height="55" as="geometry"/></mxCell>
        <mxCell id="c14" value="3. migrate runs, must exit 0" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="15" y="715" width="370" height="55" as="geometry"/></mxCell>
        <mxCell id="c15" value="4. compose up -d: api, worker, web" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="585" width="370" height="55" as="geometry"/></mxCell>
        <mxCell id="c16" value="5. Verify /health and /ready" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="650" width="370" height="55" as="geometry"/></mxCell>
        <mxCell id="c17" value="6. nginx reloads with the new upstreams" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#4d4d4d;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="395" y="715" width="370" height="55" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b&gt;Build arguments, not runtime configuration&lt;/b&gt;&lt;br&gt;every NEXT_PUBLIC_* value is inlined by next build: changing one means rebuilding the frontend image" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.2;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="830" width="780" height="60" as="geometry"/></mxCell>
        <mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;jumpStyle=arc;jumpSize=10;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c20" value="push image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;jumpStyle=arc;jumpSize=10;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.23;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c9"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c21" value="on success" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;jumpStyle=arc;jumpSize=10;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c22" value="trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;jumpStyle=arc;jumpSize=10;fontSize=15;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.77;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
