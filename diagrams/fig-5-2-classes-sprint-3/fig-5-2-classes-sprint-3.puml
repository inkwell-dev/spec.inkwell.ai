@startuml
' Figure 5.2 – Class diagram, Sprint 3: interactions, notifications and metric rollups
!include ../_style.puml
skinparam nodesep 18
skinparam ranksep 45
hide circle
hide empty methods

class User {
  - id : UUID
  - username : String
  + like(article : Article)
  + unlike(article : Article)
  + repost(article : Article)
  + follow(user : User)
  + unfollow(user : User)
  + listReposted() : Article[]
}
class Article {
  - id : UUID
  - title : String
  - publishedAt : Timestamp
  + getArticleAnalytics() : ArticleMetrics
}
class Comment {
  - content : Text
  - deletedAt : Timestamp
  + reply(content : Text) : Comment
  + remove()
}
' Association classes: a like, a repost and a follow carry data of their own,
' so each many-to-many association has a class of its own, as in the global class diagram (fig-1-12).
class Like {
  - id : UUID
  - createdAt : Timestamp
}
class Repost {
  - id : UUID
  - createdAt : Timestamp
}
class Follow {
  - id : UUID
  - createdAt : Timestamp
}
class Notification {
  - type : NotificationType
  - data : Json
  - isRead : Boolean
  + markRead()
}
class AnalyticsEvent {
  - eventType : AnalyticsEventType
  - metadata : Json
  + createEvents(batch : AnalyticsEvent[])
}
class ArticleMetrics {
  - totalViews : Integer
  - totalUniqueViews : Integer
  - avgReadTimeSec : Float
  - completionRate : Float
  - engagementRate : Float
  - paragraphDropoff : Json
  + aggregate()
}
class WriterAudienceMetrics {
  - totalUniqueReaders : Integer
  - returningReaderRate : Float
  - topCountries : Json
  - deviceSplit : Json
  + aggregate()
}
class WriterContentMetrics {
  - totalPublished : Integer
  - postingFrequency : Float
  - postingConsistency : Float
  - topTags : Json
  + aggregate()
}
class WriterQualityMetrics {
  - engagementRate : Float
  - repostRate : Float
  - commentDepth : Float
  - retentionCurve : Json
  + aggregate()
}

class NotificationType <<Enumeration>> {
  follow
  like
  comment
  reply
  repost
}
class AnalyticsEventType <<Enumeration>> {
  view
  scroll
  time_on_page
  like
  comment
  repost
}

User "0..*" -- "0..*" Article : likes
(User, Article) .. Like
User "1" -- "0..*" Comment : posts
User "0..*" -- "0..*" Article : reposts
(User, Article) .. Repost
User "follower\n0..*" -- "followed\n0..*" User : follows
(User, User) .. Follow
User "1" -- "0..*" Notification : receives
Article "1" -- "0..*" Comment : carries
Article "1" -- "0..*" AnalyticsEvent
Article "1" -- "0..1" ArticleMetrics : is rolled up into
User "1" -- "0..1" WriterAudienceMetrics
User "1" -- "0..1" WriterContentMetrics
User "1" -- "0..1" WriterQualityMetrics

' Layout: the four rollups stacked, enumerations underneath. The note on
' NULL metrics is in the report's text.
WriterAudienceMetrics -[hidden]down- WriterContentMetrics
WriterContentMetrics -[hidden]down- WriterQualityMetrics
Notification -[hidden]-- NotificationType
NotificationType -[hidden]right- AnalyticsEventType
@enduml
