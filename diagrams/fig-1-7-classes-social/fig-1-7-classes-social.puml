@startuml
' Global class diagram, part 2 of 5: the social layer and moderation.
' Likes, reposts, saves, follows, blocks and comment likes are many-to-many
' associations (join tables); the operations that create them belong to User.
!include ../_style.puml
!pragma layout elk
hide circle
hide empty methods

class User {
  - id : UUID
  - username : String
  + like(article : Article)
  + unlike(article : Article)
  + repost(article : Article)
  + save(article : Article)
  + follow(user : User)
  + block(user : User)
  + likeComment(comment : Comment)
}
class Article {
  - id : UUID
  - title : String
  + findComments() : Comment[]
}
class Comment {
  - content : Text
  - deletedAt : Timestamp
  + reply(content : Text) : Comment
  + remove()
}
class Notification {
  - type : NotificationType
  - data : Json
  - isRead : Boolean
  + markRead()
}
class Report {
  - targetType : ReportTargetType
  - targetId : UUID
  - reason : Text
  - status : ReportStatus
  + resolve(action : String)
}

class NotificationType <<Enumeration>> {
  follow
  like
  comment
  reply
  repost
  article_previewed
  article_purchased
  earnings_credited
  subscription_renewed
  comment_like
  save
  article_published
}
class ReportTargetType <<Enumeration>> {
  article
  user
  comment
}
class ReportStatus <<Enumeration>> {
  pending
  reviewed
  resolved
  dismissed
}

User "1" -- "0..*" Comment : posts
User "1" -- "0..*" Notification : receives
User "0..1" -- "0..*" Report : files
Article "1" -- "0..*" Comment : carries
Comment "0..1" -- "0..*" Comment : replies to
User "0..*" -- "0..*" Article : likes
User "0..*" -- "0..*" Article : reposts
User "0..*" -- "0..*" Article : saves
User "0..*" -- "0..*" Comment : likes
User "0..*" -- "0..*" User : follows
User "0..*" -- "0..*" User : blocks

Comment -[hidden]- NotificationType
Comment -[hidden]- ReportTargetType
Comment -[hidden]- ReportStatus
@enduml
