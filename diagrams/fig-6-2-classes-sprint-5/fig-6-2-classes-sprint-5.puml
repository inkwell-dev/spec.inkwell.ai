@startuml
' Figure 6.2 – Class diagram, Sprint 5: purchases, the credit ledger and moderation
!include ../_style.puml
skinparam nodesep 18
skinparam ranksep 45
hide circle
hide empty methods

class User {
  - id : UUID
  - accountType : AccountType
  - plan : Plan
  - earningsBalance : Integer
  - isMarketplaceEligible : Boolean
  - marketplaceEligibleAt : Timestamp
  - marketplaceEligibleSource : EligibilitySource
  + setPlan(plan : Plan)
  + grantEligibility()
  + ban()
}
class MagazineProfile {
  - subscriptionStatus : SubscriptionStatus
  - subscriptionExpiresAt : Timestamp
  - creditBalance : Integer
  - monthlyCreditAllowance : Integer
  + subscribe()
  + topUp(credits : Integer)
  + cancel()
}
class Article {
  - id : UUID
  - publisherId : UUID
  - placement : Placement
  - visibility : Visibility
  - marketplacePrice : Integer
  + switchToPublic()
  + publishUnderMasthead(magazine : User)
}
class Purchase {
  - id : UUID
  - stage : PurchaseStage
  - creditsPaid : Integer
  - platformFee : Integer
  - writerPayout : Integer
  - purchasedAt : Timestamp
  + previewUnlock(article : Article)
  + buy(article : Article)
}
class Transaction {
  - id : UUID
  - type : TransactionType
  - amount : Integer
  - idempotencyKey : String
  - status : TransactionStatus
  - metadata : Json
  + checkLedgerInvariants() : Violation[]
}
class MagazineSubscription {
  - status : SubscriptionStatus
  - creditsGranted : Integer
  - startedAt : Timestamp
  - expiresAt : Timestamp
  + renew()
}
class EligibilityAuditLog {
  - source : EligibilitySource
  - grantedBy : UUID
  - readersAt : Integer
  - reactionsAt : Integer
  + record(source : EligibilitySource)
}
class Report {
  - targetType : ReportTargetType
  - targetId : UUID
  - reason : Text
  - status : ReportStatus
  - resolvedBy : UUID
  + resolve(action : String)
}

class PurchaseStage <<Enumeration>> {
  preview_unlock
  full_purchase
}
class TransactionType <<Enumeration>> {
  subscription_charge
  monthly_credit_grant
  credit_topup
  preview_unlock
  article_full_purchase
  writer_payout
  platform_fee
  refund
}
class TransactionStatus <<Enumeration>> {
  pending
  completed
  failed
  refunded
}
class SubscriptionStatus <<Enumeration>> {
  active
  past_due
  cancelled
  refunded
}
class EligibilitySource <<Enumeration>> {
  threshold
  admin_grant
}
class ReportStatus <<Enumeration>> {
  pending
  reviewed
  resolved
  dismissed
}

User "1" -- "0..1" MagazineProfile
User "1" -- "0..*" Article : writes
User "0..1" -- "0..*" Article : publishes
Article "1" -- "0..*" Purchase
User "1" -- "0..*" Purchase : magazine
Purchase "0..1" -- "0..1" Purchase : prior preview
Purchase "1" -- "2..3" Transaction : records
User "1" -- "0..*" Transaction
User "1" -- "0..*" MagazineSubscription
User "1" -- "0..*" EligibilityAuditLog
User "0..1" -- "0..*" Report : files

' Layout: enumerations in two rows underneath; the notes on the three
' ledger rows and the three marketplace states are in the text.
MagazineProfile -[hidden]down- MagazineSubscription
MagazineSubscription -[hidden]down- EligibilityAuditLog
Report -[hidden]down- EligibilityAuditLog
MagazineSubscription -[hidden]-- PurchaseStage
PurchaseStage -[hidden]right- TransactionType
TransactionType -[hidden]right- TransactionStatus
TransactionStatus -[hidden]right- SubscriptionStatus
SubscriptionStatus -[hidden]right- EligibilitySource
EligibilitySource -[hidden]right- ReportStatus
@enduml
